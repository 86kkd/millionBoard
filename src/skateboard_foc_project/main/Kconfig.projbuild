menu "电动滑板配置"
    
    menu "组件使能配置"
        config ENABLE_HX711
            bool "启用 HX711 重量传感器"
            default y
            help
                启用 HX711 称重传感器功能。

        config ENABLE_ANGLE_SENSOR
            bool "启用角度传感器"
            default y
            help
                启用角度传感器功能。

        config ENABLE_NFC
            bool "启用NFC功能"
            default y
            help
                启用NFC读卡器功能。

        config ENABLE_GPS
            bool "启用GPS功能"
            default y
            help
                启用GPS定位功能。

        config ENABLE_MOTOR_CONTROL_FOC
            bool "启用FOC电机控制模块"
            default y
            help
                启用FOC电机控制功能。

        config ENABLE_BATTERY_MANAGEMENT
            bool "启用电池管理模块"
            default y
            help
                启用电池管理功能，包括电量监测、充放电控制等。

        config ENABLE_COMMUNICATION
            bool "启用通信模块"
            default y
            help
                启用通信功能，包括蓝牙、CAN等通信接口。

        config ENABLE_UTILS
            bool "启用工具模块"
            default y
            help
                启用通用工具功能。
    endmenu

    config ENABLE_UNIT_TESTS
        bool "启用单元测试"
        default n
        help
            启用单元测试功能。

    config MAX_SPEED
        int "电动滑板最大速度(km/h)"
        default 25
        range 5 50
        help
            设置电动滑板的最大速度，单位为km/h

endmenu