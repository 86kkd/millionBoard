menu "电机控制配置"
    
    menu "FOC控制参数"
        config FOC_PWM_FREQUENCY
            int "PWM频率 (Hz)"
            default 25000
            range 15000 50000
            help
                FOC控制器PWM频率，单位为赫兹。

        config FOC_PWM_RESOLUTION_BITS
            int "PWM分辨率 (位)"
            default 10
            range 8 14
            help
                PWM分辨率，以位为单位。值越高，控制精度越高，但频率受限。

        config MOTOR_POLE_PAIRS
            int "电机极对数"
            default 10
            range 1 50
            help
                电机的极对数。必须与实际电机匹配。

        config MOTOR_MAX_CURRENT
            int "最大电机电流 (mA)"
            default 10000
            help
                电机最大允许电流，单位为毫安。
    endmenu

    menu "主电机引脚配置"
        config MOTOR_PWM_U_PIN
            int "主电机U相PWM引脚"
            default 25
            range 0 39
            help
                连接到主电机驱动U相的PWM输出引脚。

        config MOTOR_PWM_V_PIN
            int "主电机V相PWM引脚"
            default 26
            range 0 39
            help
                连接到主电机驱动V相的PWM输出引脚。

        config MOTOR_PWM_W_PIN
            int "主电机W相PWM引脚"
            default 27
            range 0 39
            help
                连接到主电机驱动W相的PWM输出引脚。
                
        config MOTOR1_HALL_A
            int "主电机Hall传感器A引脚"
            default 4
            range 0 39
            help
                连接到主电机Hall传感器A相的GPIO引脚。
                
        config MOTOR1_HALL_B
            int "主电机Hall传感器B引脚"
            default 5
            range 0 39
            help
                连接到主电机Hall传感器B相的GPIO引脚。
                
        config MOTOR1_HALL_C
            int "主电机Hall传感器C引脚"
            default 6
            range 0 39
            help
                连接到主电机Hall传感器C相的GPIO引脚。
                
        config MOTOR1_CURRENT_A
            int "主电机电流传感器A通道"
            default 0
            range 0 7
            help
                主电机电流传感器A相的ADC通道。
                
        config MOTOR1_CURRENT_B
            int "主电机电流传感器B通道"
            default 1
            range 0 7
            help
                主电机电流传感器B相的ADC通道。
    endmenu

    menu "副电机引脚配置"
        config MOTOR2_PWM_U_PIN
            int "副电机U相PWM引脚"
            default 12
            range 0 39
            help
                连接到副电机驱动U相的PWM输出引脚。

        config MOTOR2_PWM_V_PIN
            int "副电机V相PWM引脚"
            default 13
            range 0 39
            help
                连接到副电机驱动V相的PWM输出引脚。

        config MOTOR2_PWM_W_PIN
            int "副电机W相PWM引脚"
            default 14
            range 0 39
            help
                连接到副电机驱动W相的PWM输出引脚。
                
        config MOTOR2_HALL_A
            int "副电机Hall传感器A引脚"
            default 15
            range 0 39
            help
                连接到副电机Hall传感器A相的GPIO引脚。
                
        config MOTOR2_HALL_B
            int "副电机Hall传感器B引脚"
            default 16
            range 0 39
            help
                连接到副电机Hall传感器B相的GPIO引脚。
                
        config MOTOR2_HALL_C
            int "副电机Hall传感器C引脚"
            default 17
            range 0 39
            help
                连接到副电机Hall传感器C相的GPIO引脚。
                
        config MOTOR2_CURRENT_A
            int "副电机电流传感器A通道"
            default 2
            range 0 7
            help
                副电机电流传感器A相的ADC通道。
                
        config MOTOR2_CURRENT_B
            int "副电机电流传感器B通道"
            default 3
            range 0 7
            help
                副电机电流传感器B相的ADC通道。
    endmenu

    menu "电机通用配置"
        config MOTOR_ENABLE_PIN
            int "电机使能引脚(共用)"
            default 4
            range 0 39
            help
                连接到所有电机驱动使能的共用GPIO引脚。
    endmenu

    menu "控制器参数"
        config VELOCITY_PID_P
            int "速度PID-P系数 (x1000)"
            default 1200
            help
                速度环PID控制器的比例系数，乘以1000存储。

        config VELOCITY_PID_I
            int "速度PID-I系数 (x1000)"
            default 20000
            help
                速度环PID控制器的积分系数，乘以1000存储。

        config VELOCITY_PID_D
            int "速度PID-D系数 (x1000)"
            default 40
            help
                速度环PID控制器的微分系数，乘以1000存储。

        config VELOCITY_LPF_TIME_CONSTANT
            int "速度低通滤波时间常数 (x1000)"
            default 10
            help
                速度低通滤波器的时间常数，乘以1000存储。
    endmenu

    menu "电机测试设置"
        depends on ENABLE_UNIT_TESTS
        
        config MOTOR_TEST_MAX_SPEED
            int "测试最大速度百分比 (%)"
            default 50
            range 10 100
            help
                测试时使用的最大速度百分比。
    endmenu

endmenu