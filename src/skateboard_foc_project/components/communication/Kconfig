menu "通信配置"
    
    menu "I2C通信设置"
        config I2C_MASTER_FREQ_HZ
            int "I2C主机频率 (Hz)"
            default 100000
            range 100000 400000
            help
                I2C主机通信频率，单位为赫兹。
                标准模式为100kHz，快速模式为400kHz。

        config NFC_SDA_GPIO
            int "I2C SDA引脚GPIO编号"
            default 44
            range 0 47
            help
                I2C数据线(SDA)引脚的GPIO编号。

        config NFC_SCL_GPIO
            int "I2C SCL引脚GPIO编号"
            default 43
            range 0 47
            help
                I2C时钟线(SCL)引脚的GPIO编号。

        config I2C_TIMEOUT_MS
            int "I2C通信超时时间 (ms)"
            default 1000
            range 100 5000
            help
                I2C通信的默认超时时间，单位为毫秒。
    endmenu

    menu "CAN通信设置"
        config CAN_TX_GPIO
            int "CAN发送引脚GPIO编号"
            default 18
            range 0 47
            help
                CAN总线发送引脚的GPIO编号。

        config CAN_RX_GPIO
            int "CAN接收引脚GPIO编号"
            default 17
            range 0 47
            help
                CAN总线接收引脚的GPIO编号。
                
        config CAN_BITRATE
            int "CAN总线比特率"
            default 250000
            range 125000 1000000
            help
                CAN总线通信比特率，支持125kbps、250kbps、500kbps和1Mbps。

        config CAN_RX_TASK_STACK_SIZE
            int "CAN接收任务栈大小"
            default 4096
            range 2048 8192
            help
                CAN接收任务的栈大小，单位为字节。

        config CAN_RX_TASK_PRIORITY
            int "CAN接收任务优先级"
            default 5
            range 1 24
            help
                CAN接收任务的优先级，范围为1-24。
                
        config CAN_RX_QUEUE_SIZE
            int "CAN接收队列大小"
            default 20
            range 5 50
            help
                CAN接收消息队列的大小。
    endmenu

    menu "UART通信设置"
        config UART_RX_BUFFER_SIZE
            int "UART接收缓冲区大小"
            default 1024
            range 256 2048
            help
                UART接收缓冲区大小，单位为字节。

        config UART_TX_BUFFER_SIZE
            int "UART发送缓冲区大小"
            default 1024
            range 256 2048
            help
                UART发送缓冲区大小，单位为字节。
    endmenu

    menu "通信测试设置"
        depends on ENABLE_UNIT_TESTS
        
        config COMM_TEST_LOOPBACK
            bool "启用回环测试"
            default y
            help
                启用通信模块的回环测试。
    endmenu

endmenu